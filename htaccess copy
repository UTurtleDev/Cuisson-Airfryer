# Configuration Passenger pour Django
PassengerEnabled On
PassengerAppRoot /home/wida2850/diagnostic-gcl.sitesdemo.net
PassengerPython /home/wida2850/diagnostic-gcl.sitesdemo.net/.venv/bin/python

# Servir les fichiers statiques directement (SANS passer par Django)
<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Si le fichier ou dossier existe, le servir directement
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]
    
    # Sinon, rediriger vers Django
    RewriteRule ^(.*)$ passenger_wsgi.py [QSA,L]
</IfModule>

# Désactiver Passenger pour les dossiers statiques
<Directory /home/wida2850/diagnostic-gcl.sitesdemo.net/staticfiles>
    PassengerEnabled off
    Order allow,deny
    Allow from all
    Require all grantedls-
</Directory>

<Directory /home/wida2850/diagnostic-gcl.sitesdemo.net/media>
    PassengerEnabled off
    Order allow,deny
    Allow from all
    Require all granted
</Directory>

# Forcer les bons MIME types pour les fichiers statiques
<IfModule mod_mime.c>
    AddType text/css .css
    AddType application/javascript .js
    AddType image/svg+xml .svg
</IfModule>