# Copier ce fichier en .env et adapter les valeurs.
# Le fichier .env ne doit JAMAIS être commité.
# Pas de commentaire en fin de ligne : il ferait partie de la valeur.

# --- Django ---
# Générer la clé avec :
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=a-remplacer-par-une-cle-aleatoire
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_CSRF_TRUSTED_ORIGINS=https://mondomaine.fr

# Adresse de l'administration, à changer en production.
# DJANGO_URL_ADMINISTRATION=une-adresse-a-vous/

# --- Base de données ---
# En développement, rien à renseigner : sqlite par défaut.
# En production, USE_MYSQL=True rend les variables DB_* obligatoires,
# et sqlite est refusé.
# USE_MYSQL=True
# DB_ENGINE=django.db.backends.mysql
# DB_NAME=compte_nomdelabase
# DB_USER=compte_utilisateur
# DB_PASSWORD=le-mot-de-passe-tel-quel-sans-encodage
# DB_HOST=localhost
# DB_PORT=3306

# --- Fichiers ---
# DJANGO_STATIC_ROOT=/home/compte/domaine/staticfiles
# DJANGO_MEDIA_ROOT=/home/compte/domaine/media

# --- Courriels ---
# Sans ces variables, les messages s'affichent dans la console.
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DJANGO_EMAIL_HOST=mail.mondomaine.fr
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_USERNAME=cuisson@mondomaine.fr
# DJANGO_EMAIL_PASSWORD=
# DJANGO_EMAIL_USE_TLS=True
DJANGO_DEFAULT_FROM_EMAIL=cuisson@localhost

# --- Sécurité ---
# À passer à False uniquement le temps d'obtenir le certificat SSL.
# DJANGO_SECURE_SSL_REDIRECT=False
