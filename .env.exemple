# Copier ce fichier en .env et adapter les valeurs.
# Le fichier .env ne doit JAMAIS être commité.

# --- Django ---
DJANGO_SECRET_KEY=a-remplacer-par-une-cle-aleatoire
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_CSRF_TRUSTED_ORIGINS=https://mondomaine.fr

# --- Base de données ---
# Développement (défaut) : sqlite:///db.sqlite3
# Production o2switch  : mysql://utilisateur:motdepasse@localhost:3306/nom_de_la_base
DATABASE_URL=sqlite:///db.sqlite3

# --- Fichiers ---
# DJANGO_STATIC_ROOT=/home/compte/public_html/static
# DJANGO_MEDIA_ROOT=/home/compte/medias

# --- Courriels ---
# Développement : affichage console (défaut).
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DJANGO_EMAIL_HOST=mail.mondomaine.fr
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_USERNAME=cuisson@mondomaine.fr
# DJANGO_EMAIL_PASSWORD=
# DJANGO_EMAIL_USE_TLS=True
DJANGO_DEFAULT_FROM_EMAIL=cuisson@localhost

# --- Administration ---
# DJANGO_URL_ADMINISTRATION=gestion-secrete/
